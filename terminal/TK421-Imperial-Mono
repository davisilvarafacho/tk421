# TK-421 Imperial Mono: Ghostty theme. Zero colour: the 16 ANSI slots are a ladder of graphite greys (the blue slots are the coolest greys, for directories). Meaning comes from lightness and bold, not hue.
# Greys carry a very slight cold tint, like Theme.imperial (theme/Theme.qml). Every normal colour is >= 4.8:1 on the
# background, bright-black 4.55:1 (fish autosuggestions). Test it: terminal/try-palette.sh terminal/TK421-Imperial-Mono

background = #0C0B0D
foreground = #E8E6E3

cursor-color = #E8E6E3
cursor-text = #0C0B0D

selection-background = #2A2A30
selection-foreground = #F4F2EF

# black, red, green, yellow, blue, magenta, cyan, white
